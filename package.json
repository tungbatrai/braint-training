{
  "name": "brain-training",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch backend/local.ts",
    "dev:web": "vite --config vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "npm run typecheck && npm run build:frontend && npm run build:worker",
    "build:frontend": "vite build --config vite.config.ts",
    "build:worker": "node scripts/build-worker.mjs",
    "admin:promote": "tsx backend/promote-admin.ts",
    "test:worker": "npm run build:worker && tsx scripts/worker-smoke.ts",
    "configure:vercel": "node scripts/configure-vercel.mjs",
    "build:cloudflare": "cf build --mode worker",
    "test:cloudflare": "node scripts/test-cloudflare.mjs"
  },
  "dependencies": {
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@tanstack/react-query": "^5.107.1",
    "antd": "^5.29.3",
    "axios": "^1.21.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.12",
    "@cloudflare/workers-types": "^5.20261109.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.2.1",
    "cf": "^1.0.0-beta.28",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.0",
    "miniflare": "^5.20261104.0-beta",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
