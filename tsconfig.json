{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "node",
      "vite/client",
      "@cloudflare/workers-types"
    ]
  },
  "include": [
    "frontend/src",
    "backend",
    "shared",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "e2e",
    "scripts",
    "cloudflare.config.ts"
  ]
}
